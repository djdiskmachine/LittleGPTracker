<!--
    MAPPING FOR KEYBOARDS & SDL2 CONTROLLERS
    belongs in location of binary
    -=-=These keys match keyboard and standard SDL2 GameController=-=-
    enable DUMPEVENT in config.xml to help with mapping if needed
-->
<MAPPINGS>

    <!-- Keyboard Controls -->
    <MAP src="key:0:q" dst="/event/lshoulder" />
    <MAP src="key:0:w" dst="/event/rshoulder" />

    <MAP src="key:0:up" dst="/event/up" />
    <MAP src="key:0:down" dst="/event/down" />
    <MAP src="key:0:left" dst="/event/left" />
    <MAP src="key:0:right" dst="/event/right" />

    <MAP src="key:0:a" dst="/event/b" />
    <MAP src="key:0:s" dst="/event/a" />
    <MAP src="key:0:space" dst="/event/start" />

    <!-- D-Pad (SDL2 GameController Buttons) -->
    <MAP src="but:0:11" dst="/event/up" />
    <MAP src="but:0:12" dst="/event/down" />
    <MAP src="but:0:13" dst="/event/left" />
    <MAP src="but:0:14" dst="/event/right" />

    <!-- Left Analog Stick (Axes) -->
    <MAP src="joy:0:1-" dst="/event/up" />
    <MAP src="joy:0:1+" dst="/event/down" />
    <MAP src="joy:0:0-" dst="/event/left" />
    <MAP src="joy:0:0+" dst="/event/right" />

    <!-- Hat D-Pad (Fallback) -->
    <MAP src="hat:0:0:1" dst="/event/up" />
    <MAP src="hat:0:0:4" dst="/event/down" />
    <MAP src="hat:0:0:8" dst="/event/left" />
    <MAP src="hat:0:0:2" dst="/event/right" />

    <!-- Face Buttons (A / B) -->
    <MAP src="but:0:0" dst="/event/a" />
    <MAP src="but:0:1" dst="/event/b" />

    <!-- Shoulder Buttons (LB / RB, buttons 9/10 on SDL2, 4/5 on DInput) -->
    <MAP src="but:0:9" dst="/event/lshoulder" />
    <MAP src="but:0:10" dst="/event/rshoulder" />
    <MAP src="but:0:4" dst="/event/lshoulder" />
    <MAP src="but:0:5" dst="/event/rshoulder" />

    <!-- Start Buttons (Menu / Start) -->
    <MAP src="but:0:6" dst="/event/start" />
    <MAP src="but:0:7" dst="/event/start" />

<!--
Macro 1
        Stop Phrase (Selected phrase cue stop)
        <MAP src="but:0:3" dst="/event/rshoulder" />
        <MAP src="but:0:3" dst="/event/start" />
-->
<!--
Macro 2
        Queue Phrases (Current row Phrases cue play)
        <MAP src="but:0:2" dst="/event/lshoulder" />
        <MAP src="but:0:2" dst="/event/start" />
-->
</MAPPINGS>
